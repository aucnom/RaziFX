	<queryString language="SQL">
		<![CDATA[SELECT
    s.salary_id,
    e.first_name,
    e.last_name,
    j.title AS job_title,
    s.amount,
    s.pay_date
FROM
    salaries s
JOIN
    employees e ON s.employee_id = e.employee_id
JOIN
    jobs j ON e.job_id = j.job_id;]]>
	</queryString>
	<field name="salary_id" class="java.lang.Integer">
