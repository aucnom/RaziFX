	<queryString language="SQL">
		<![CDATA[SELECT
    p.payment_id,
    o.order_id,
    c.customer_id,
    c.first_name,
    c.last_name,
    p.payment_date,
    p.amount,
    p.discount,
    p.payment_method,
    o.status AS order_status  -- Include order status for context
FROM
    payments AS p
JOIN
    orders AS o ON p.order_id = o.order_id
JOIN
    customers AS c ON o.customer_id = c.customer_id
ORDER BY
    p.payment_date DESC;  -- Order by payment date (newest first)]]>
	</queryString>
