	<queryString language="SQL">
		<![CDATA[SELECT
    pp.payment_id,
    s.first_name,
    s.last_name,
    pp.payment_date,
    pp.amount,
    pp.discount,
    pp.payment_method
FROM
    purchase_payments AS pp
INNER JOIN
    suppliers AS s ON pp.supplier_id = s.supplier_id
ORDER BY
    pp.payment_date DESC; -- Optional: Order by payment date]]>
	</queryString>
