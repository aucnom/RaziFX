	<queryString language="SQL">
		<![CDATA[SELECT
    c.customer_id,
    c.last_name,
    c.phone_number,
    o.order_date,
    p.name,
    p.price,
    od.quantity,
    od.unit_price,
    (od.quantity * od.unit_price) AS amount_due 
FROM
    order_details od
JOIN
    orders o ON od.order_id = o.order_id
JOIN
    customers c ON o.customer_id = c.customer_id
JOIN
    products p ON od.product_id = p.product_id;]]>
	</queryString>
