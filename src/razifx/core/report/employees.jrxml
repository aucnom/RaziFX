	<queryString language="SQL">
		<![CDATA[SELECT
    e.employee_id,
    e.first_name,
    e.last_name,
    j.title AS job_title,
    j.base_salary,    
    e.national_id,
    e.birthdate,
    e.phone_number,
    e.address,
    e.gender
FROM
    employees e
JOIN
    jobs j ON e.job_id = j.job_id
ORDER BY
    e.employee_id;]]>
	</queryString>
