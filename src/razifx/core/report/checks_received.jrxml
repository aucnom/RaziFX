	<queryString language="SQL">
		<![CDATA[SELECT
    cr.check_id,
    c.first_name,
    c.last_name,
    cr.check_number,
    cr.check_date,
    cr.amount
FROM
    checks_received AS cr
INNER JOIN
    customers AS c ON cr.customer_id = c.customer_id
ORDER BY
    cr.check_date DESC;]]>
	</queryString>
